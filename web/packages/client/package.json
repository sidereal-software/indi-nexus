{
  "name": "@indi-nexus/client",
  "version": "0.2.0",
  "description": "Framework-agnostic TypeScript client and typed property store for the INDINexus web bridge.",
  "license": "MIT",
  "author": "Sidereal Software",
  "homepage": "https://indi-nexus.sidereal.software/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidereal-software/indi-nexus.git",
    "directory": "web/packages/client"
  },
  "bugs": "https://github.com/sidereal-software/indi-nexus/issues",
  "keywords": [
    "indi",
    "astronomy",
    "instrument-control",
    "websocket",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "node ../../scripts/extract-doc-snippets.mjs --only=client && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
