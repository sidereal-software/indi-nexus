{
  "name": "@indi-nexus/react",
  "version": "0.2.0",
  "description": "React hooks and shadcn/ui-based components for building INDINexus frontends.",
  "license": "MIT",
  "author": "Sidereal Software",
  "homepage": "https://indi-nexus.sidereal.software/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidereal-software/indi-nexus.git",
    "directory": "web/packages/react"
  },
  "bugs": "https://github.com/sidereal-software/indi-nexus/issues",
  "keywords": [
    "indi",
    "astronomy",
    "instrument-control",
    "react",
    "hooks",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "tsup && pnpm build:css && cp src/theme.css dist/theme.css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "tsup --watch",
    "typecheck": "node ../../scripts/extract-doc-snippets.mjs --only=react && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "@testing-library/react": "^16.0.0"
  },
  "dependencies": {
    "@indi-nexus/client": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    }
  }
}
